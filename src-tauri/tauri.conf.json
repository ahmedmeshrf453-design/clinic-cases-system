{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Clinic Cases System",
  "version": "3.0.0",
  "identifier": "com.cliniccases.system",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "label": "main",
      "title": "Clinic Cases System",
      "width": 1440,
      "height": 900,
      "minWidth": 1050,
      "minHeight": 680,
      "maximized": true,
      "resizable": true,
      "fullscreen": false
    }],
    "security": { "csp": null }
  },
  "bundle": { "active": false }
}
